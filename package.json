{
  "name": "@koppajs/koppajs-language-server",
  "version": "0.2.1",
  "description": "Language Server Protocol adapter for KoppaJS language tooling.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koppajs/koppajs-language-server.git"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run validate",
    "release:check": "npm pack --dry-run --ignore-scripts",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm run check:docs && npm run check:meta && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "npm run check",
    "check:docs": "npm run check:docs:contract && npm run check:docs:semantics",
    "check:docs:contract": "node scripts/check-doc-contract.mjs",
    "check:docs:semantics": "node scripts/check-doc-semantics.mjs",
    "check:meta": "node scripts/check-meta-layer.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@koppajs/koppajs-language-core": "^0.2.1",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@koppajs/koppajs-core": "^3.0.11",
    "@koppajs/koppajs-kpa-check": "^0.2.0",
    "@koppajs/koppajs-router": "^0.1.8",
    "@koppajs/koppajs-vite-plugin": "^2.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "private": false,
  "overrides": {
    "minimatch": "11.0.3"
  }
}
